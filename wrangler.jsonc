{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-webhook-mitm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "grok-webhook-mitm.workarea.io", "custom_domain": true }
  ],
  "secrets": {
    "required": ["GITHUB_WEBHOOK_SECRET", "GROK_WEBHOOK_URL", "GROK_WEBHOOK_KEY"]
  },
  "observability": { "enabled": true }
}
